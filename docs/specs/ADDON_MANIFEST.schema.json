{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harvey.local/schemas/addon-manifest.schema.json",
  "title": "Harvey Add-on Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "id",
    "version",
    "display_name",
    "summary",
    "entrypoint",
    "capabilities",
    "permissions",
    "data_access",
    "network",
    "limits",
    "health_check",
    "support"
  ],
  "properties": {
    "manifest_version": {
      "const": "1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "entrypoint": {
      "type": "string",
      "pattern": "^[a-zA-Z_][a-zA-Z0-9_.]*:[a-zA-Z_][a-zA-Z0-9_]*$"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "mode",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          },
          "mode": {
            "enum": [
              "read",
              "write"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "approval": {
            "enum": [
              "never",
              "required",
              "policy"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "read"
                }
              },
              "required": [
                "mode"
              ]
            },
            "then": {
              "properties": {
                "approval": {
                  "enum": [
                    "never"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "write"
                }
              },
              "required": [
                "mode"
              ]
            },
            "then": {
              "required": [
                "approval"
              ],
              "properties": {
                "approval": {
                  "enum": [
                    "required",
                    "policy"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "data_access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reads",
        "writes",
        "retention_days"
      ],
      "properties": {
        "reads": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "public",
              "business",
              "personal",
              "sensitive"
            ]
          }
        },
        "writes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "public",
              "business",
              "personal",
              "sensitive"
            ]
          }
        },
        "retention_days": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "sends_to_vendor": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "hostname"
          }
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "https_hosts"
      ],
      "properties": {
        "https_hosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "hostname"
          }
        },
        "allow_redirects": {
          "const": false
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_seconds",
        "max_response_bytes",
        "requests_per_minute"
      ],
      "properties": {
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 120
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 50000000
        },
        "requests_per_minute": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      }
    },
    "health_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "timeout_seconds"
      ],
      "properties": {
        "kind": {
          "enum": [
            "command",
            "http",
            "module"
          ]
        },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 60
        },
        "target": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentation",
        "owner"
      ],
      "properties": {
        "documentation": {
          "type": "string",
          "format": "uri"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "minimum_harvey_version": {
          "type": "string"
        }
      }
    }
  }
}
